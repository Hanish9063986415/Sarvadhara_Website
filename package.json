{
  "name": "sarvadhara-tech-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/clean-next.mjs && node scripts/kill-port.mjs 3000 && node scripts/get-ip.js && next dev -H 0.0.0.0",
    "build": "next build",
    "postbuild": "node -e \"console.log('\\n  Use npm run start for production.\\n  Before npm run dev again, stop start/dev and let dev clear .next (or run npm run dev:clean).\\n')\"",
    "start": "next start",
    "lint": "next lint",
    "migrate:supabase": "node scripts/migrate-json-to-supabase.mjs",
    "migrate:supabase:dry-run": "node scripts/migrate-json-to-supabase.mjs --dry-run",
    "migrate:supabase:wipe": "node scripts/migrate-json-to-supabase.mjs --wipe"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^10.16.16",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.303.0",
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
}
