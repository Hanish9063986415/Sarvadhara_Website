# Sarvadhara Automate (CRM) — set in .env.local (never commit real secrets)

AUTOMATE_USERNAME=your-email@example.com
AUTOMATE_PASSWORD=
AUTOMATE_SESSION_SECRET=

# Admin — required only to delete projects (add and edit use AUTOMATE_USERNAME)
AUTOMATE_PROJECTS_USERNAME=admin@example.com
AUTOMATE_PROJECTS_PASSWORD=

# Optional — shown on maintenance tax invoices (client-safe public GSTIN only)
NEXT_PUBLIC_SARVADHARA_GSTIN=

# Optional — public invoice links in WhatsApp (defaults to browser origin / VERCEL_URL)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase (Automate CRM) — service role is server-only; never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CRM storage: Supabase by default. Set `json` only for legacy local data/*.json files.
# CRM_DATA_BACKEND=supabase
